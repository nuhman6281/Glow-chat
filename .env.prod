# Production Environment Configuration

# Database Configuration
MONGO_URI=mongodb://mongo:27017/glow-chat-prod
MONGODB_URI=mongodb://mongo:27017/glow-chat-prod
MONGO_DB_NAME=glow-chat-prod
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=YOUR_SECURE_MONGO_PASSWORD_HERE
MONGO_PORT=27017

# Redis Configuration
REDIS_URL=redis://redis:6379
REDIS_PORT=6379

# Server Configuration
PORT=3000
NODE_ENV=production
BACKEND_PORT=3000

# JWT Configuration
JWT_SECRET=YOUR_SUPER_SECURE_JWT_SECRET_HERE_MINIMUM_32_CHARACTERS
JWT_EXPIRES_IN=24h

# Client Configuration
CLIENT_URL=https://your-domain.com
FRONTEND_PORT=3001

# CORS Configuration
CORS_ORIGIN=https://your-domain.com

# API Configuration
API_BASE_URL=https://api.your-domain.com
REACT_APP_API_URL=https://api.your-domain.com

# File Upload Configuration (Cloudinary)
CLOUDINARY_CLOUD_NAME=your-production-cloud-name
CLOUDINARY_API_KEY=your-production-api-key
CLOUDINARY_API_SECRET=your-production-api-secret
MAX_FILE_SIZE=10485760

# Email Configuration
SMTP_HOST=smtp.your-email-provider.com
SMTP_PORT=587
SMTP_USER=your-production-email@your-domain.com
SMTP_PASS=your-production-email-password
EMAIL_FROM=noreply@your-domain.com

# WebRTC Configuration
TURN_SERVER_URL=turn:your-production-turn-server.com
TURN_USERNAME=your-production-turn-username
TURN_CREDENTIAL=your-production-turn-credential

# Logging Configuration
LOG_LEVEL=info
LOG_FILE=logs/prod.log

# Security Configuration
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=50
BCRYPT_SALT_ROUNDS=14

# Session Configuration
SESSION_SECRET=YOUR_SUPER_SECURE_SESSION_SECRET_HERE_MINIMUM_32_CHARACTERS
SESSION_TIMEOUT=1800000

# Production Tools
DEBUG=false
ENABLE_SWAGGER=false

# SSL/TLS Configuration
SSL_KEY_PATH=/path/to/ssl/private.key
SSL_CERT_PATH=/path/to/ssl/certificate.crt
SSL_CA_PATH=/path/to/ssl/ca-bundle.crt

# Performance Configuration
CLUSTER_MODE=true
MAX_WORKERS=4
MEMORY_LIMIT=512m

# Monitoring Configuration
HEALTH_CHECK_INTERVAL=30000
METRICS_ENABLED=true
METRICS_PORT=9090

# Database Connection Pool
DB_POOL_SIZE=20
DB_TIMEOUT=30000
DB_RETRY_ATTEMPTS=3
