# ===========================================
# GLOW CHAT - ENVIRONMENT CONFIGURATION
# ===========================================

# ===========================================
# SERVER CONFIGURATION
# ===========================================
NODE_ENV=development
PORT=3000
BACKEND_PORT=3000
FRONTEND_PORT=8080

# ===========================================
# DATABASE CONFIGURATION
# ===========================================
# MongoDB Configuration
MONGODB_URI=mongodb://localhost:27017/glow-chat
MONGO_URI=mongodb://localhost:27017/glow-chat
MONGO_DB_NAME=glow-chat
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=password123
MONGO_PORT=27017

# Database Performance Settings
DB_POOL_SIZE=10
DB_TIMEOUT=30000
DB_RETRY_ATTEMPTS=3

# ===========================================
# REDIS CONFIGURATION
# ===========================================
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379
REDIS_PASSWORD=

# ===========================================
# SECURITY CONFIGURATION
# ===========================================
# JWT Configuration (REQUIRED - Change in production!)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# Session Configuration (REQUIRED - Change in production!)
SESSION_SECRET=your-super-secret-session-key-change-this-in-production-min-32-chars

# Password Hashing
BCRYPT_SALT_ROUNDS=12

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# ===========================================
# CLIENT CONFIGURATION
# ===========================================
CLIENT_URL=http://localhost:8080
CORS_ORIGIN=http://localhost:8080
API_BASE_URL=http://localhost:3000
REACT_APP_API_URL=http://localhost:3000
VITE_API_URL=http://localhost:3000
VITE_WS_URL=ws://localhost:3000

# ===========================================
# FILE UPLOAD CONFIGURATION
# ===========================================
MAX_FILE_SIZE=5242880

# Cloudinary Configuration (Optional)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ===========================================
# EMAIL CONFIGURATION (Optional)
# ===========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@glow-chat.com

# ===========================================
# WEBRTC CONFIGURATION (Optional)
# ===========================================
TURN_SERVER_URL=
TURN_USERNAME=
TURN_CREDENTIAL=

# ===========================================
# LOGGING CONFIGURATION
# ===========================================
LOG_LEVEL=info
LOG_FILE=logs/app.log
DEBUG=false

# ===========================================
# DEVELOPMENT TOOLS
# ===========================================
ENABLE_SWAGGER=false

# ===========================================
# PRODUCTION DEPLOYMENT (Docker)
# ===========================================
# Domain Configuration
API_DOMAIN=api.example.com
FRONTEND_DOMAIN=chat.example.com
MONITORING_DOMAIN=monitoring.example.com

# SSL/ACME Configuration
ACME_EMAIL=admin@example.com

# Version Tags (Production)
BACKEND_VERSION=latest
FRONTEND_VERSION=latest
