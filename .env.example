# ========================================
# GLOW CHAT - ENVIRONMENT CONFIGURATION
# ========================================

# ========================================
# SERVER CONFIGURATION
# ========================================
PORT=3000
NODE_ENV=development
BACKEND_PORT=3000

# ========================================
# DATABASE CONFIGURATION
# ========================================
MONGODB_URI=mongodb://localhost:27017/glow-chat
MONGO_DB_NAME=glow-chat
MONGO_ROOT_USERNAME=admin
MONGO_ROOT_PASSWORD=password123
MONGO_PORT=27017
DB_POOL_SIZE=10
DB_TIMEOUT=30000
DB_RETRY_ATTEMPTS=3

# ========================================
# REDIS CONFIGURATION (Optional)
# ========================================
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# ========================================
# JWT CONFIGURATION
# ========================================
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production-min-32-chars
JWT_EXPIRES_IN=7d

# ========================================
# CLIENT CONFIGURATION
# ========================================
CLIENT_URL=http://localhost:8080
FRONTEND_PORT=8080
CORS_ORIGIN=http://localhost:8080
API_BASE_URL=http://localhost:3000
REACT_APP_API_URL=http://localhost:3000

# ========================================
# FILE UPLOAD CONFIGURATION (Optional)
# ========================================
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
MAX_FILE_SIZE=5242880

# ========================================
# EMAIL CONFIGURATION (Optional)
# ========================================
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
EMAIL_FROM=noreply@glow-chat.com

# ========================================
# WEBRTC CONFIGURATION (Optional)
# ========================================
TURN_SERVER_URL=turn:your-turn-server.com
TURN_USERNAME=your-turn-username
TURN_CREDENTIAL=your-turn-credential

# ========================================
# LOGGING CONFIGURATION
# ========================================
LOG_LEVEL=info
LOG_FILE=logs/app.log

# ========================================
# SECURITY CONFIGURATION
# ========================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
BCRYPT_SALT_ROUNDS=12
SESSION_SECRET=your-super-secret-session-key-change-this-in-production-min-32-chars
SESSION_TIMEOUT=86400000

# ========================================
# DEVELOPMENT TOOLS
# ========================================
DEBUG=true
ENABLE_SWAGGER=true

# ========================================
# SSL/TLS CONFIGURATION (Production)
# ========================================
SSL_KEY_PATH=/path/to/private.key
SSL_CERT_PATH=/path/to/certificate.crt
SSL_CA_PATH=/path/to/ca-bundle.crt

# ========================================
# PERFORMANCE CONFIGURATION
# ========================================
CLUSTER_MODE=false
MAX_WORKERS=4
MEMORY_LIMIT=512MB
HEALTH_CHECK_INTERVAL=30000
METRICS_ENABLED=false
METRICS_PORT=9090

# ========================================
# SOUND NOTIFICATIONS CONFIGURATION
# ========================================
ENABLE_SOUND_NOTIFICATIONS=true
DEFAULT_RINGTONE=default
DEFAULT_MESSAGE_SOUND=message
DEFAULT_CALL_SOUND=call

# ========================================
# FEATURE FLAGS
# ========================================
ENABLE_VIDEO_CALLS=true
ENABLE_SCREEN_SHARING=true
ENABLE_VOICE_MESSAGES=true
ENABLE_FILE_SHARING=true
ENABLE_MESSAGE_REACTIONS=true
ENABLE_MESSAGE_REPLIES=true
ENABLE_MESSAGE_FORWARDING=true
ENABLE_MESSAGE_EDITING=true
ENABLE_MESSAGE_DELETION=true
ENABLE_USER_BLOCKING=true
ENABLE_FRIEND_REQUESTS=true
ENABLE_GROUP_PERMISSIONS=true
ENABLE_MESSAGE_ENCRYPTION=false
ENABLE_DISAPPEARING_MESSAGES=false
ENABLE_CHAT_BACKUP=true
ENABLE_MESSAGE_SEARCH=true
ENABLE_MESSAGE_EXPORT=true
ENABLE_MESSAGE_SCHEDULING=true
ENABLE_MESSAGE_TRANSLATION=false
ENABLE_CALL_RECORDING=false
ENABLE_BACKGROUND_BLUR=true
ENABLE_NOISE_CANCELLATION=true
